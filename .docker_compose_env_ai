# This file contains default values for environment values that are needed either by Docker Compose itself
# or by the docker compose files.

# COMPOSE_PROJECT_NAME declares the prefix of the name of the Docker containers. So if the
# project name is 'acme_support' then the web container is named either 'acme_support_web_1' for
# Compose V1 or 'acme_support-web-1 for Compose V2. The project name also declares
# the prefix of named volumes. Thus changing the project name allows to have
# separate containers and volumes for separate installations.
#
# Note that when COMPOSE_PROJECT_NAME is set in the shell environment,
# then that setting has higher precedence.
COMPOSE_PROJECT_NAME=otobo-ai

# COMPOSE_FILE is a collection of files, separated by COMPOSE_PATH_SEPARATOR, that make up the final config.
# These files usually reside in the subdirectory docker-compose.
# Additional services can be added by concatenating more files to COMPOSE_FILE.
COMPOSE_PATH_SEPARATOR=:

COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_otobo-docker.yml # if you run the OTOBO docker compose stack
# COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_standalone.yml # Use this for independent setup (OTOBO native installation)
# COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_otobo-docker.yml:docker-compose/otobo-ai_dev.yml # for development

# docker-compose/otobo-ai_openwebui.yml
# Optional: Adds a chat interface to the stack.

# docker-compose/otobo-ai_mcp.yml
# Optional: Adds a MCP server to the stack.


# RAG
################################

# Token to auth this API, generate via `openssl rand -hex 32`
OTOBO_AI_API_KEY=CHANGEME

# Optional, Ip address of this server inside the docker, default is "0.0.0.0"
OTOBO_AI_HOST=0.0.0.0

# Optional: port of this server
OTOBO_AI_PORT=8000


# Parameters for Vector Database
OTOBO_AI_CHROMA_DIR=/chroma
OTOBO_AI_EMBEDDING_CHUNK_SIZE=1100
OTOBO_AI_EMBEDDING_CHUNK_OVERLAP=100

# Parameters for language models
# Optional: token to auth the llm server
OTOBO_AI_LLM_API_KEY="api-key-to-the-llm-server"

# URL of OpenAI API compatible LLM server
OTOBO_AI_LLM_HOST=http://myollama:11434

# Optional: llama llm model, default is llama2:13b-chat
OTOBO_AI_LLM_MODEL=llama3.3:70b
OTOBO_AI_LLM_EVAL_MODEL=llama3.3:70b

# Optional: embedding model, default is bge-m3
### WARNING ###
# Changeing this value in production will require to recreate the database because the dimension of the embedding models might be different.
OTOBO_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Optional: temperature (see llama doc), default is 0.1
# OTOBO_AI_LLM_TEMPERATURE=0.1
# OTOBO_AI_LLM_EVAL_TEMPERATURE=0.1

# Parameters for LANGFUSE
# Optional: Keys for debugging
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL=""

# OTOBO_AI_LOG_FILE
# OTOBO_AI_LOG_LEVEL

# Parameters for MariaDB
OTOBO_AI_DB_HOST=mariadb
OTOBO_AI_DB_PORT=3306
OTOBO_AI_DB_NAME=fulltext
OTOBO_AI_DB_USER=otobo_ai
OTOBO_AI_DB_PW=your password


